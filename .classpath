<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry excluding="Project/|Project/Custom Exceptions/" kind="src" path=""/>
	<classpathentry excluding="Custom Exceptions/" kind="src" path="Project"/>
	<classpathentry kind="src" path="Project/Custom Exceptions"/>
	<classpathentry combineaccessrules="false" kind="src" path="/CS2DataStructuresLib"/>
	<classpathentry combineaccessrules="false" kind="src" path="/CS2GraphWindowLib"/>
	<classpathentry combineaccessrules="false" kind="src" path="/CS2-Support"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
